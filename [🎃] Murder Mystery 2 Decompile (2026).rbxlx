        p17.MultipleContainer.Visible = false;
        p18.SingleContainer.Visible = false;
        p18.MultipleContainer.Visible = true;
        u1:ClearMultipleContainer(p18);
        local v22 = 1;

        for i, v in u1:GetWeaponSalvageRewards(p20) do
            local v23 = v.Amount[1];
            local ItemInfo = ItemService:GetItemInfo("Materials", i);
            ItemService:ApplyMiniItemFrame(p18.MultipleContainer["Material" .. v22], ItemInfo, v23);
            v22 = v22 + 1;
        end;

        u1.CurrentlyCrafting = {
            {
                itemType = "Weapons",
                amount = 1,
                itemID = p20
            }
        };

        return;
    end;

    if p19 == "Materials" then
        for _, v in u1.CurrentlyCrafting do
            if v.itemType == "Weapons" then
                u1.CurrentlyCrafting = {};
                break;
            end;
        end;

        local v24 = nil;

        for i, v in u1.CurrentlyCrafting do
            if v.itemID == p20 then
                v24 = i;
                break;
            end;
        end;

        if v24 then
            if u1.CurrentlyCrafting[v24].amount < ProfileData.Materials.Owned[p20] then
                local v25 = u1.CurrentlyCrafting[v24];
                v25.amount = v25.amount + 1;
            end;
        elseif #u1.CurrentlyCrafting < 4 then
            table.insert(u1.CurrentlyCrafting, {
                itemType = "Materials",
                amount = 1,
                itemID = p20
            });
        end;

        for i = 1, 4 do
            local v26 = u1.CurrentlyCrafting[i];
            local v27;

            if v26 then
                local ItemInfo = ItemService:GetItemInfo("Materials", v26.itemID);
                ItemService:ApplyMiniItemFrame(p17.MultipleContainer["Material" .. i], ItemInfo, v26.amount);
                v27 = i;
            else
                ItemService:ApplyMiniItemFrame(p17.MultipleContainer["Material" .. i], nil, 0);
                v27 = i;
            end;
        end;

