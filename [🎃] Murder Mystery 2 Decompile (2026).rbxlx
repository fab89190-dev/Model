function comma_value(p1)
    repeat
        local v2;
        p1, v2 = string.gsub(p1, "^(-?%d+)(%d%d%d)", "%1,%2");
        k = v2;
    until k == 0;

    return p1;
end;

function UpdateCash()
    -- upvalues: ProfileData (copy), Shop (copy)
    local v3 = ProfileData.Materials.Owned.Gems or 0;
    Shop.Title.Coins.Container.Amount.Text = comma_value((math.floor(ProfileData.Materials.Owned.Coins or 0)));
    Shop.Title.Gems.Container.Amount.Text = comma_value(v3);
end;

