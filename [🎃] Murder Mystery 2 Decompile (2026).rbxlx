        if CraftingResult then
            local ItemInfo = ItemService:GetItemInfo("Recipes", CraftingResult);
            ItemService:ApplyItemToFrame(p18.SingleContainer.NewItem, ItemInfo, 1);
        else
            ItemService:ApplyItemToFrame(p18.SingleContainer.NewItem, nil, 1);
        end;

        p18.SingleContainer.Visible = CraftingResult ~= nil;
        p18.MultipleContainer.Visible = false;
        p17.SingleContainer.Visible = false;
        p17.MultipleContainer.Visible = true;
    end;
end;

